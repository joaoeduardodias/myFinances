DATABASE_URL="postgresql://docker:docker@localhost:5435/myfinances"
# Assina toda sessão. A API recusa subir com menos de 32 caracteres ou com
# um valor de exemplo — segredo fraco não daria erro nenhum, só um JWT
# forjável. Gere com: openssl rand -hex 32
JWT_SECRET=""
PORT=3333
TIMEZONE="America/Sao_Paulo"
# Origem do web, liberada no CORS da API.
WEB_URL="http://localhost:5173"
# Publica a documentação da API em /docs (Swagger UI + OpenAPI).
# Fechado por padrão: em produção o /docs aberto entrega o mapa completo das
# rotas e seus schemas. Ligue só em desenvolvimento.
API_DOCS_ENABLED="true"
# Pluggy. Client ID e Client Secret ficam no Dashboard → Applications.
# O secret aparece uma vez só: copie na criação.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
PLUGGY_BASE_URL="https://api.pluggy.ai"
# Opcional: sem ele o webhook fica desligado. Com ele, mínimo de 32
# caracteres. Gere com: openssl rand -hex 24
PLUGGY_WEBHOOK_SECRET=""
# Opcional: chave da API do Gemini (Google AI Studio). Sem ela, o WhatsApp não interpreta lançamentos.
GEMINI_API_KEY=""
# Opcional: WhatsApp Cloud API (Meta). Token do usuário do sistema, segredo do app,
# token de verificação do webhook (você escolhe) e id do número.
# O webhook só sobe com as quatro WHATSAPP_* e com a GEMINI_API_KEY acima.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Cloudflare R2. O endpoint é o da conta — o bucket entra em S3_BUCKET, não no
# path (o SDK o põe como subdomínio).
S3_ENDPOINT="https://<conta>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Web (Vite).
VITE_API_URL="http://localhost:3333"
