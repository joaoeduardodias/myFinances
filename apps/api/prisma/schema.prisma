generator client {
  provider     = "prisma-client"
  output       = "../src/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String         @map("password_hash")
  // Só dígitos, como a Meta manda em `from` (ex.: 5511999999999).
  whatsappPhone String?        @unique @map("whatsapp_phone")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  sessions      UserSession[]
  connections   Connection[]
  accounts      Account[]
  transactions  Transaction[]
  cardBills     CardBill[]
  recurrences   Recurrence[]
  payslips      Payslip[]
  categoryNecessities CategoryNecessity[]
  categoryLimits CategoryLimit[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  advisorSummary AdvisorSummary?
  advisorMessages AdvisorMessage[]
  advisorGoals AdvisorGoal[]
  // Avisar quando o "Quanto posso gastar" ficar negativo.
  spendableNegative Boolean @default(false) @map("spendable_negative")

  @@map("users")
}

model UserSession {
  id                       String    @id @default(uuid())
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  /// O token anterior e quando foi trocado: se ele voltar depois da janela da
  /// rotação, alguém copiou o refresh token e a sessão é revogada.
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  refreshTokenRotatedAt    DateTime? @map("refresh_token_rotated_at")
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")
  userId                   String    @map("user_id")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_sessions")
}

enum AccountType {
  BANK
  CREDIT
  WALLET
}

enum TransactionStatus {
  PENDING
  POSTED
}

enum TransactionSource {
  PLUGGY
  MANUAL
  SYSTEM
}

enum RecurrenceDirection {
  IN
  OUT
}

enum DayRule {
  DAY_OF_MONTH
  NTH_BUSINESS_DAY
}

enum NonBusinessDayPolicy {
  ANTICIPATE
  POSTPONE
  KEEP
}

enum RecurrenceStatus {
  SUGGESTED
  CONFIRMED
  DISMISSED
  /// Empréstimo quitado à mão (sem número de parcelas informado).
  PAID_OFF
}

enum RecurrenceKind {
  MONTHLY
  LOAN
  /// Nunca passa pela Pluggy (ex.: vale-alimentação num cartão à parte).
  EXTERNAL
}

enum PayslipType {
  MONTHLY
  ADVANCE
  THIRTEENTH
  VACATION
}

enum PayslipStatus {
  UNRECOGNIZED
  RECOGNIZED
  MANUAL
}

enum PayslipLineKind {
  EARNING
  DEDUCTION
}

model Connection {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pluggyItemId     String    @unique @map("pluggy_item_id")
  connectorName    String    @map("connector_name")
  /// Código COMPE do banco (104 = Caixa): o conector MeuPluggy não diz qual é.
  institutionCode  String?   @map("institution_code")
  status           String
  consentExpiresAt DateTime? @map("consent_expires_at")
  lastSyncedAt     DateTime? @map("last_synced_at")
  lastError        String?   @map("last_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  accounts         Account[]

  @@index([userId])
  @@map("connections")
}

model Account {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId    String?       @map("connection_id")
  connection      Connection?   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  pluggyAccountId String?       @unique @map("pluggy_account_id")
  type            AccountType
  name            String
  number          String?
  balanceCents    Int           @map("balance_cents")
  closingDay      Int?          @map("closing_day")
  dueDay          Int?          @map("due_day")
  creditLimitCents Int?        @map("credit_limit_cents")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  transactions    Transaction[]
  cardBills       CardBill[]
  recurrences     Recurrence[]

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id                  String            @id @default(uuid())
  userId              String            @map("user_id")
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId           String            @map("account_id")
  account             Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pluggyTransactionId String?           @unique @map("pluggy_transaction_id")
  date                DateTime          @db.Date
  description         String
  descriptionKey      String            @map("description_key")
  amountCents         Int               @map("amount_cents")
  status              TransactionStatus
  source              TransactionSource
  pluggyCategory      String?           @map("pluggy_category")
  category            String?
  categoryLocked      Boolean           @default(false) @map("category_locked")
  // O sync não sobrescreve description/descriptionKey.
  descriptionLocked   Boolean           @default(false) @map("description_locked")
  // wamid que criou ou renomeou a transação; em MANUAL marca "lançamento do WhatsApp esperando a Pluggy".
  whatsappMessageId   String?           @unique @map("whatsapp_message_id")
  // Descrição da Pluggy antes de um renomear feito na hora da mensagem (para o "desfazer").
  originalDescription String?           @map("original_description")
  isTransfer          Boolean           @default(false) @map("is_transfer")
  transferLocked      Boolean           @default(false) @map("transfer_locked")
  // Marca do João sobre este gasto; sem marca vale a da categoria.
  necessity           Necessity?
  transferPairId      String?           @unique @map("transfer_pair_id")
  transferPair        Transaction?      @relation("TransferPair", fields: [transferPairId], references: [id], onDelete: SetNull)
  transferPairOf      Transaction?      @relation("TransferPair")
  installmentNumber   Int?              @map("installment_number")
  totalInstallments   Int?              @map("total_installments")
  // Recorrente escolhido pelo João para esta transação (nunca vinculado sozinho).
  recurrenceId        String?           @map("recurrence_id")
  recurrence          Recurrence?       @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  linkDismissals      RecurrenceLinkDismissal[]
  payrollLinks        RecurrencePayrollLink[]
  createdAt           DateTime          @default(now()) @map("created_at")

  @@index([userId, date])
  @@index([recurrenceId])
  @@map("transactions")
}

model CardBill {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String   @map("account_id")
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pluggyBillId String   @unique @map("pluggy_bill_id")
  dueDate      DateTime @map("due_date") @db.Date
  totalCents   Int      @map("total_cents")
  paidCents    Int      @map("paid_cents")

  @@index([userId])
  @@map("card_bills")
}

model Recurrence {
  id                   String               @id @default(uuid())
  userId               String               @map("user_id")
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Só informação: o vínculo vale para transações de qualquer conta.
  accountId            String?              @map("account_id")
  account              Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  kind                 RecurrenceKind       @default(MONTHLY)
  description          String
  descriptionKey       String               @map("description_key")
  direction            RecurrenceDirection
  expectedAmountCents  Int                  @map("expected_amount_cents")
  dayRule              DayRule              @map("day_rule")
  dayValue             Int                  @map("day_value")
  nonBusinessDayPolicy NonBusinessDayPolicy @default(ANTICIPATE) @map("non_business_day_policy")
  status               RecurrenceStatus
  // "Faltam N parcelas" do empréstimo e o dia em que foi informado: cada vínculo
  // com data depois dele desconta uma.
  remainingInstallments Int?                @map("remaining_installments")
  remainingAsOf        DateTime?            @map("remaining_as_of") @db.Date
  // Empréstimo descontado em folha: a parcela já vem abatida do salário, e o
  // vínculo é com o crédito do salário (em `payrollLinks`, sem tirá-lo do recorrente dele).
  payrollDeduction     Boolean              @default(false) @map("payroll_deduction")
  // Recebimento de que a parcela em folha é descontada; sem ele, vale o salário principal.
  payrollSourceId      String?              @map("payroll_source_id")
  payrollSource        Recurrence?          @relation("PayrollSource", fields: [payrollSourceId], references: [id], onDelete: SetNull)
  payrollLoans         Recurrence[]         @relation("PayrollSource")
  createdAt            DateTime             @default(now()) @map("created_at")
  transactions         Transaction[]
  linkDismissals       RecurrenceLinkDismissal[]
  payrollLinks         RecurrencePayrollLink[]

  /// O dia entra na identidade: salário e vale chegam com a mesma descrição.
  /// A conta não entra: o mesmo recorrente pode ser pago de contas diferentes.
  @@unique([userId, descriptionKey, direction, dayRule, dayValue])
  @@map("recurrences")
}

/// "Não é": a transação não volta como sugestão de vínculo deste recorrente.
model RecurrenceLinkDismissal {
  recurrenceId  String      @map("recurrence_id")
  recurrence    Recurrence  @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@id([recurrenceId, transactionId])
  @@map("recurrence_link_dismissals")
}

/// Crédito do salário em que a parcela do empréstimo em folha foi descontada.
/// À parte do `Transaction.recurrenceId`: o crédito continua sendo do salário.
model RecurrencePayrollLink {
  recurrenceId  String      @map("recurrence_id")
  recurrence    Recurrence  @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@id([recurrenceId, transactionId])
  @@index([transactionId])
  @@map("recurrence_payroll_links")
}

model Payslip {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  competence String
  type       PayslipType
  status     PayslipStatus
  grossCents Int?          @map("gross_cents")
  netCents   Int?          @map("net_cents")
  fileKey    String        @map("file_key")
  fileName   String        @map("file_name")
  fileSha256 String        @map("file_sha256")
  createdAt  DateTime      @default(now()) @map("created_at")
  lines      PayslipLine[]

  @@unique([userId, fileSha256])
  @@map("payslips")
}

model PayslipLine {
  id          String          @id @default(uuid())
  payslipId   String          @map("payslip_id")
  payslip     Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  kind        PayslipLineKind
  description String
  reference   String?
  amountCents Int             @map("amount_cents")
  position    Int

  @@map("payslip_lines")
}

enum Necessity {
  ESSENTIAL
  AVOIDABLE
  EMERGENCY
}

/// Troca do João sobre o padrão essencial/evitável de uma categoria.
model CategoryNecessity {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  necessity Necessity

  @@unique([userId, category])
  @@map("category_necessities")
}

enum LimitStatus {
  ACTIVE
  DECLINED
}

model CategoryLimit {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String
  status        LimitStatus
  /// Nulo só quando DECLINED.
  limitCents    Int?        @map("limit_cents")
  /// Último mês (YYYY-MM) em que o limite foi revisado.
  reviewedMonth String?     @map("reviewed_month")

  @@unique([userId, category])
  @@map("category_limits")
}

enum NotificationKind {
  SPENDABLE_NEGATIVE
  CATEGORY_WARNING
  CATEGORY_EXCEEDED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  /// Nulo nos avisos de saldo: o Postgres aceita vários nulos no unique.
  dedupeKey String?          @map("dedupe_key")
  title     String
  body      String
  createdAt DateTime         @default(now()) @map("created_at")
  readAt    DateTime?        @map("read_at")

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Inscrição de Web Push de um navegador; o endpoint identifica o navegador.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

/// Último resumo do consultor: um por usuário, trocado no máximo uma vez por dia.
model AdvisorSummary {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Dia (YYYY-MM-DD, fuso do app) em que foi gerado.
  day       String
  points    String[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("advisor_summaries")
}

/// Chamadas do consultor ao Gemini por dia; a cota é da chave, não do usuário.
enum AdvisorRole {
  USER
  ASSISTANT
}

/// Chat do consultor no app; some depois de ADVISOR_CHAT_DAYS.
model AdvisorMessage {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AdvisorRole
  text      String
  /// Metas propostas na resposta (GoalTarget[]); viram meta só quando o João aceita.
  proposals Json?
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("advisor_messages")
}

enum AdvisorGoalKind {
  CATEGORY
  SAVINGS
}

/// Meta aceita no chat do consultor; ativa enquanto `endedAt` é nulo.
model AdvisorGoal {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          AdvisorGoalKind
  /// Só no teto de categoria.
  category      String?
  targetCents   Int?            @map("target_cents")
  /// Só na sobra: % mínima da renda.
  targetPercent Int?            @map("target_percent")
  /// Mês (YYYY-MM) em que foi aceita; o acompanhamento começa nele.
  startMonth    String          @map("start_month")
  endedAt       DateTime?       @map("ended_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@map("advisor_goals")
}

model AdvisorUsage {
  day   String @id
  calls Int

  @@map("advisor_usage")
}
